# ─────────────────────────────────────────────────────────────────────────────
# deploy/Caddyfile.template — manual Caddy template (env substitution)
# ─────────────────────────────────────────────────────────────────────────────
# This is the hand-loadable template: Caddy reads {$VAR} from its own
# environment. The generated, fully literal file is produced by
# modules/edge-proxy.js (deploy/templates/Caddyfile.template) and is what
# start.js validates and install-edge.sh installs.
#
#   set -a; . ./.env; set +a
#   caddy validate --config deploy/Caddyfile.template
#
# Admin is loopback-only: /admin and /api/admin are answered 404 at the edge
# and are NEVER forwarded to the API.
# ─────────────────────────────────────────────────────────────────────────────
{
	http_port {$CADDY_HTTP_PORT}
	https_port {$CADDY_HTTPS_PORT}
}

https://{$MAIN_HOST} {
	# TLS_MODE=internal: Caddy local CA, offline self-signed loopback.
	# TLS_MODE=acme: use the rendered file instead (automatic HTTPS).
	tls internal
	route {
		@admin path /admin* /api/admin*
		respond @admin 404
		reverse_proxy 127.0.0.1:{$PORT} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}
}
