# ═══════════════════════════════════════════════════════════════════════
# ZombieCoder — Mission Barisal · Gateway Server  (.env.example)
# ---------------------------------------------------------------------
# Usage:
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows)
# Replace every <YOUR_*> placeholder with a real API key, then run:
#   node start.js --start-all -s
#
# Requires Node.js >= 24 (built-in node:sqlite, no dependencies).
# Never commit or push .env; it is git-ignored. Secrets live only in .env.
# ═══════════════════════════════════════════════════════════════════════

# ─────────────── 1. Core Server ───────────────
# Main HTTP listen port (every endpoint is served here)
PORT=5050
# Public URL (the address clients use; Caddy terminates TLS in front)
# Local default: https://localhost. Set your real public URL for a public edge.
APP_URL=https://localhost

# ─────────────── 1a. Edge (Caddy) ───────────────
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# internal = Caddy local CA (offline, no public DNS needed)
# acme     = public certificate (needs DNS-only record + inbound 80/443)
TLS_MODE=internal
ACME_EMAIL=
# Main site host; empty -> derived from APP_URL
MAIN_HOST=localhost
# Tool hosts: <subdomain>.<TOOL_BASE_DOMAIN>; empty -> main host only
TOOL_BASE_DOMAIN=
# Application listen address; keep loopback when Caddy is in front
BIND_HOST=localhost
# Display name / status
SERVER_NAME=ZombieCoder
SERVER_TYPE=development

# ─────────────── 2. Runtime directories (all env-driven) ───────────────
DATA_DIR=data
LOG_DIR=logs
CACHE_DIR=cache
CACHE_TTL=86400000
CACHE_MAX_ENTRIES=1000
SKILLS_DIR=skills
SSOT_DIR=.zombiecoder
LOCK_DIR=data/locks
# SQLite models/agents DB (node:sqlite — zero-dependency)
DB_SQLITE_PATH=data/models.db
# The DB is mandatory at boot. Missing => DB_FATAL missing (exit 78).
# Set DB_BOOTSTRAP=1 for the first boot only; it creates the schema.
DB_BOOTSTRAP=0
# A locked DB waits this long per attempt, retries this often up to 3 times,
# then stops with DB_FATAL busy.
DB_BUSY_TIMEOUT_MS=5000
DB_BUSY_RETRY_MS=500

# ─────────────── 3. Auth / security (fail-closed) ───────────────
# Admin endpoints return 401 unless a token is configured.
ADMIN_TOKEN=
ADMIN_API_KEY=
ADMIN_USER=
MCP_ADMIN_TOKEN=
# Local development only: ADMIN_ALLOW_UNAUTHENTICATED=true
# MCP identity: an alternative to the admin password.
# CORS allow-list is derived from APP_URL, MAIN_HOST and deploy/tools.json.
# There is no hand-written origin list to drift out of sync.
# Agent filesystem scope: unrestricted (default) | restricted -> sandbox
#   restricted = workspace + ALLOWED_DIRS + $HOME
AGENT_FS_SCOPE=unrestricted
# Extra directories for restricted mode (comma-separated):
ALLOWED_DIRS=
# Body-size guard: a larger request gets 413 (bytes; default 10 MiB)
MAX_BODY_SIZE=10485760
# Rate limit and cooldown
MAX_RATE_LIMIT=60
RATE_LIMIT_COOLDOWN=10000
SESSION_TTL=86400000
# shell-exec (tool) limits
EXEC_TIMEOUT=60000
EXEC_MAX_BUFFER=10485760

# ─────────────── 4. Provider — opencode ───────────────
OPENCODE_BASE=https://opencode.ai/inference/openai/v1
OPENCODE_API_KEY=<YOUR_OPENCODE_KEY>
OPENCODE_PRIORITY=6
OPENCODE_MODELS=
# Masked pair format: "name:apiModel,name2:apiModel2" (comma-separated).
# The name is what clients and agents see; apiModel is sent upstream.

# ─────────────── 5. Provider — groq ───────────────
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=<YOUR_GROQ_KEY>
GROQ_PRIORITY=2
GROQ_MODELS=

# ─────────────── 6. Provider — gemini ───────────────
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=<YOUR_GEMINI_KEY>
GEMINI_PRIORITY=3
GEMINI_MODELS=

# ─────────────── 7. Provider — ollama (local) ───────────────
# Point OLLAMA_BASE at the running `ollama serve` instance.
OLLAMA_BASE=http://localhost:11434/v1
OLLAMA_API_KEY=
# ollama.com cloud credentials are owned by the separate ollama_cloud
# provider below; they are never sent to the local server.
OLLAMA_CLOUD_API_KEY=
OLLAMA_PRIORITY=1
OLLAMA_TYPE=openai
# OLLAMA_DIALECT matters more than OLLAMA_TYPE: adapterFor() selects by
# provider ID first, so `type` never decides the wire format here.
#   (empty)  = NATIVE -> {OLLAMA_BASE without /v1}/api/chat
#              correct for a direct `ollama serve` on 11434
#   openai   = /v1    -> {OLLAMA_BASE}/chat/completions
#              for local-llm-bridge, LM Studio, vLLM, llama.cpp server
# A wrong dialect returns 404 "no route for POST /api/chat" and the model is
# silently skipped, so verify the dialect before blaming the model.
# openai = Ollama's /v1/chat/completions. It emits native tool_calls directly.
OLLAMA_DIALECT=openai
OLLAMA_MODELS=
# Plain tag or masked pair. A tag keeps its colon: qwen2:0.5b. A masked pair
# uses "name=>apiModel" because a colon would be read as part of the tag.
# Leave empty to let the DB / provider sync supply the list.
# Provider calls may exceed the 60s transport default while still producing
# a valid answer, so the budget is explicit and per provider.
OLLAMA_TIMEOUT_MS=1200000
OLLAMA_STREAM_TIMEOUT_MS=1200000

# ─────────────── 7b. Provider — ollama cloud ───────────────
# Native /api/chat at ollama.com with Authorization: Bearer. The key and the
# model list are independent of the local Ollama server.
OLLAMA_CLOUD_BASE=https://ollama.com
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_PRIORITY=5
OLLAMA_CLOUD_TYPE=openai
OLLAMA_CLOUD_DIALECT=
OLLAMA_CLOUD_MODELS=
OLLAMA_CLOUD_TIMEOUT_MS=1200000
OLLAMA_CLOUD_STREAM_TIMEOUT_MS=1200000
# How often the gateway re-reads only the local provider model lists (the
# bridge in front of Ollama/llama.cpp/LM Studio/vLLM). A model server that
# starts or stops later is reflected without a restart; cloud providers are
# never polled by this timer.
LOCAL_MODELS_REFRESH_MS=20000

# ─────────────── 8. Provider — custom_N (OpenAI-compatible) ───────────────
# A custom provider is ALWAYS OpenAI-compatible: custom_N ids speak the
# OpenAI /v1 protocol and reject every other TYPE. The database is the source
# of truth for 1..N; env only seeds the first default. Add
# CUSTOM_PROVIDER_2_*, CUSTOM_PROVIDER_3_*, ... as needed — there is no cap.
# The admin panel writes the same rows with POST /api/admin/providers.
CUSTOM_PROVIDER_1_ENABLED=false
CUSTOM_PROVIDER_1_NAME=
CUSTOM_PROVIDER_1_URL=
CUSTOM_PROVIDER_1_KEY=
CUSTOM_PROVIDER_1_PRIORITY=
CUSTOM_PROVIDER_1_MODELS=
# Pair format: "public=>apiModel". A plain entry keeps the upstream model id.
# Optional unix-socket transport: when SOCKET is set the provider is dialled
# over this socket instead of TCP. URL may stay empty when SOCKET is set.
CUSTOM_PROVIDER_1_SOCKET=
# Per-provider budgets (optional; unset means the adapter default):
# CUSTOM_PROVIDER_1_TIMEOUT_MS=300000
# CUSTOM_PROVIDER_1_STREAM_TIMEOUT_MS=600000
# CUSTOM_PROVIDER_1_MAX_PROMPT_CHARS=2500
# CUSTOM_PROVIDER_1_MAX_TOOLS=
# CUSTOM_PROVIDER_1_CONTEXT_WINDOW=
# CUSTOM_PROVIDER_<N>_TYPE is accepted for backward compatibility but always
# resolves to openai; the gateway logs CUSTOM_PROVIDER_TYPE_IGNORED if it is
# set to anything else.

# Native llama.cpp (/completion, no /v1 prefix) is NOT a custom_N provider.
# Create it in the admin panel with type "llamacpp" (a DB row), or leave it
# out. These anchors are optional and only help your own custom_N URL lines:
LLAMA_CPP_BASE=http://localhost:9932
LLAMA_CPP_URL=${LLAMA_CPP_BASE}/v1
LLAMA_CPP_MODEL=
# DB-backed providers (rows created from the admin UI) have no budget
# columns. PROVIDER_<ID>_* carries the same knobs for them; <ID> is the row id
# uppercased with non-alphanumerics replaced by "_".
# llama-uds = llama.cpp server over UDS, Jinja template.
PROVIDER_LLAMA_UDS_MAX_PROMPT_CHARS=1800
PROVIDER_LLAMA_UDS_MAX_TOKENS=160
PROVIDER_LLAMA_UDS_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# ─────────────── 9. Linux - UDS ───────────────
# ONE inbound socket for every client. UDS_1..UDS_N are candidates: they are
# tried in numeric order, only the first usable path binds, the next one is
# the immediate fallback. Add UDS_4, UDS_5 ... without touching code.
# The same socket serves MCP newline JSON-RPC and OpenAI HTTP.
UDS_1=data/run/mcp.sock
UDS_2=data/run/mcp2.sock
UDS_3=data/run/mcp3.sock
# Set 0 to disable the OpenAI HTTP surface on the UDS (MCP stays available).
UDS_OPENAI=1
# Windows only: loopback TCP fallback because Windows has no UDS.
UDS_PORT=5150
GRPC_PORT=5052
# Optional in-process TLS listener: only starts when both files exist.
HTTPS_PORT=5444
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
LOCAL_UDS_TIMEOUT=10000
# Outbound proxy list: comma-separated http(s):// URLs, or `direct` for no proxy.
# Empty also means direct. The server validates this list at boot.
PROXY_LIST=direct
# Shell used by shell-exec (Linux and Windows)
EXEC_SHELL_LINUX=/bin/bash
EXEC_SHELL_WIN=powershell.exe

# ─────────────── 10. Local LLM bridge (local-llm-bridge.js) ───────────────
# The bridge is also a first-class gateway provider. The gateway treats it as
# one OpenAI-compatible source; upstream discovery stays inside the bridge.
# BRIDGE_MODEL (singular) configures the bridge itself; BRIDGE_MODELS (plural)
# is the gateway's optional model mapping ("name=>apiModel", empty = discover).
BRIDGE_ENABLED=1
BRIDGE_BASE=
BRIDGE_API_KEY=
BRIDGE_PRIORITY=999
# Tool budget: lib/tool-budget.js is the ONLY resolver. These values are the
# global ceiling; a provider can only lower them.
MCP_TOOL_BUDGET_MAX=24
MCP_TOOL_BUDGET_PIN=tts__tts_speak,ocr__ocr_image
MCP_TOOL_BUDGET_STRATEGY=intent
MCP_TOOL_BUDGET_MAX_BYTES=12000
MCP_TOOL_BUDGET_MAX_PREFILL_MS=45000
MCP_TOOL_PREFILL_TOKENS_PER_SEC=30
BRIDGE_MODELS=
# CORS: empty = loopback origins only; "*" = any; or a comma-separated list
BRIDGE_ALLOWED_ORIGINS=
BRIDGE_PORT=11435
BRIDGE_INTERNAL_PORT=11437
# auto = use the configured upstreams; llama = also spawn a bundled
# llama-server when one is installed. There is no conventional-port scan.
BRIDGE_BACKEND=auto
# Empty = use whichever model a live upstream reports. No invented model.
BRIDGE_MODEL=
BRIDGE_UPSTREAM_MODEL=
# Explicit upstreams only: "name=url,name=url". Nothing else on the machine
# is probed. A missing server is skipped, never fatal.
BRIDGE_UPSTREAMS=
BRIDGE_REFRESH_MS=15000
BRIDGE_PROBE_TIMEOUT_MS=1200
BRIDGE_CTX=512
BRIDGE_THREADS=4
# One budget for the bridge's upstream call. The gateway waits this value plus
# BRIDGE_TIMEOUT_GRACE_MS, so its request never expires while the bridge is
# still working. Both sides read lib/provider-timeout.js.
BRIDGE_TIMEOUT_MS=1200000
BRIDGE_TIMEOUT_GRACE_MS=5000
# Legacy single upstream. Set it explicitly; empty means no upstream unless
# BRIDGE_UPSTREAMS or BRIDGE_BACKEND=llama supplies one.
BRIDGE_OLLAMA_URL=http://127.0.0.1:11434

# ─────────────── 11. MCP transports (external mcp/) ───────────────
# Local MCP servers are stdio children of the gateway; they do not use ports.
# These two are only for running universal-adapter as a standalone HTTP service.
ADAPTER_HTTP_PORT=5400
ADAPTER_HTTPS_PORT=5443
# Remote MCP servers (comma-separated "<name>:<url>")
EXTERNAL_MCP_URLS=
REMOTE_MCP_SERVERS=
MCP_CLIENTS_FILE=data/mcp-clients.json
MCP_READY_TIMEOUT_MS=30000

# ─────────────── 12. External integrations ───────────────
# Pusher (real-time dashboard)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Facebook Ads MCP
FB_ACCESS_TOKEN=
# PHP/Frontend (optional)
FRONTEND_PORT=8081
FRONTEND_URL=http://localhost:8081

# ─────────────── 13. Git content sync (optional) ───────────────
# persona/skill/instruction files pulled at startup (raw.githubusercontent URL)
GIT_PERSONAS_URL=
GIT_SKILLS_URL=
GIT_INSTRUCTIONS_URL=

# ─────────────── 14. Behaviour flags ───────────────
# Anti-Dote pipeline: validate → proof → contract → execute → verify
ANTIDOTE_ENABLED=true
# Boundary schema check: an invalid provider response is rejected, not forwarded
BOUNDARY_VALIDATE=true
# Dev-model template (HAS_DEV_MODELS=true shows temporary dev models)
HAS_DEV_MODELS=false
# r2t (response-to-tool) virtual model
R2T_ENABLED=false
# Heartbeat/watchdog interval (ms)
WATCHDOG_INTERVAL=60000
# Debate / back-end-for-end limit
MAX_DEBATE_ROUNDS=3
# Model alias — "alias:realModel", comma-separated
# `llama-local` is the stable agent-facing id; point it at the local model you
# actually run (install.sh fills the Ollama model when it is reachable).
MODEL_ALIASES=llama-local:llama3.2:latest
# Default model for every agent whose DB row and agent file name no model.
# Must be a model one configured provider serves (for example the public name
# from GEMINI_MODELS). Empty means chat requests fail with `Unknown model ""`
# instead of guessing a provider — set it.
AGENT_MODEL=
# Model for utility calls (intent extraction, alignment, proof checks). Empty
# means "first usable model in the live catalog", so no provider is required.
# Set it only when a specific cheap model should handle those calls.
UTILITY_MODEL=
# Optional edge-tts binary path used by audio report scripts.
EDGE_TTS_PATH=

# ─────────────── 15. Branding (API/display) ───────────────
BRANDING_ORGANIZATION=ZombieCoder
BRANDING_TAGLINE=Mission Barisal
BRANDING_WEBSITE=https://zombiecoder.my.id
BRANDING_EMAIL=infi@zombiecoder.my.id