# ═══════════════════════════════════════════════════════════════════════
# ZombieCoder — Mission Barisal · Gateway Server  (.env.example)
# ---------------------------------------------------------------------
# Usage:
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows)
# Replace every <YOUR_*> placeholder with a real API key, then run:
#   node start.js --start-all -s
#
# Requires Node.js >= 24 (built-in node:sqlite, no dependencies).
# Never commit or push .env; it is git-ignored. Secrets live only in .env.
# ═══════════════════════════════════════════════════════════════════════

# ─────────────── 1. Core Server ───────────────
# Main HTTP listen port (every endpoint is served here)
PORT=5050
# Public URL (the address clients use; Caddy terminates TLS in front)
# Local default: https://localhost. Set your real public URL for a public edge.
APP_URL=https://localhost

# ─────────────── 1a. Edge (Caddy) ───────────────
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# internal = Caddy local CA (offline, no public DNS needed)
# acme     = public certificate (needs DNS-only record + inbound 80/443)
TLS_MODE=internal
ACME_EMAIL=
# Main site host; empty -> derived from APP_URL
MAIN_HOST=localhost
# Tool hosts: <subdomain>.<TOOL_BASE_DOMAIN>; empty -> main host only
TOOL_BASE_DOMAIN=
# Application listen address; keep loopback when Caddy is in front
BIND_HOST=127.0.0.1
# Display name / status
SERVER_NAME=ZombieCoder
SERVER_TYPE=development

# ─────────────── 2. Runtime directories (all env-driven) ───────────────
DATA_DIR=data
LOG_DIR=logs
CACHE_DIR=cache
CACHE_TTL=86400000
CACHE_MAX_ENTRIES=1000
SKILLS_DIR=skills
SSOT_DIR=.zombiecoder
LOCK_DIR=data/locks
# SQLite models/agents DB (node:sqlite — zero-dependency)
DB_SQLITE_PATH=data/models.db

# ─────────────── 3. Auth / security (fail-closed) ───────────────
# Admin endpoints return 401 unless a token is configured.
ADMIN_TOKEN=
ADMIN_API_KEY=
ADMIN_USER=
MCP_ADMIN_TOKEN=
# Local development only: ADMIN_ALLOW_UNAUTHENTICATED=true
# MCP identity: an alternative to the admin password.
# CORS allow-list is derived from APP_URL, MAIN_HOST and deploy/tools.json.
# There is no hand-written origin list to drift out of sync.
# Agent filesystem scope: unrestricted (default) | restricted -> sandbox
#   restricted = workspace + ALLOWED_DIRS + $HOME
AGENT_FS_SCOPE=unrestricted
# Extra directories for restricted mode (comma-separated):
ALLOWED_DIRS=
# Body-size guard: a larger request gets 413 (bytes; default 10 MiB)
MAX_BODY_SIZE=10485760
# Rate limit and cooldown
MAX_RATE_LIMIT=60
RATE_LIMIT_COOLDOWN=10000
SESSION_TTL=86400000
# shell-exec (tool) limits
EXEC_TIMEOUT=60000
EXEC_MAX_BUFFER=10485760

# ─────────────── 4. Provider — opencode ───────────────
OPENCODE_BASE=https://opencode.ai/inference/openai/v1
OPENCODE_API_KEY=<YOUR_OPENCODE_KEY>
OPENCODE_PRIORITY=6
OPENCODE_MODELS=
# Masked pair format: "name:apiModel,name2:apiModel2" (comma-separated).
# The name is what clients and agents see; apiModel is sent upstream.

# ─────────────── 5. Provider — groq ───────────────
GROQ_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=<YOUR_GROQ_KEY>
GROQ_PRIORITY=2
GROQ_MODELS=

# ─────────────── 6. Provider — gemini ───────────────
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=<YOUR_GEMINI_KEY>
GEMINI_PRIORITY=3
GEMINI_MODELS=

# ─────────────── 7. Provider — ollama (local) ───────────────
# Point OLLAMA_BASE at the running `ollama serve` instance.
OLLAMA_BASE=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
# ollama.com cloud credentials, when the local server proxies a cloud model:
OLLAMA_CLOUD_API_KEY=
OLLAMA_PRIORITY=1
OLLAMA_TYPE=openai
# OLLAMA_DIALECT matters more than OLLAMA_TYPE: adapterFor() selects by
# provider ID first, so `type` never decides the wire format here.
#   (empty)  = NATIVE -> {OLLAMA_BASE without /v1}/api/chat
#              correct for a direct `ollama serve` on 11434
#   openai   = /v1    -> {OLLAMA_BASE}/chat/completions
#              for local-llm-bridge, LM Studio, vLLM, llama.cpp server
# A wrong dialect returns 404 "no route for POST /api/chat" and the model is
# silently skipped, so verify the dialect before blaming the model.
OLLAMA_DIALECT=
OLLAMA_MODELS=
# Plain tag or masked pair. A tag keeps its colon: qwen2:0.5b. A masked pair
# uses "name=>apiModel" because a colon would be read as part of the tag.
# Leave empty to let the DB / provider sync supply the list.
# Local CPU answers can exceed the 60s transport default while still being
# valid, so the budget is explicit and per provider.
OLLAMA_TIMEOUT_MS=1200000
OLLAMA_STREAM_TIMEOUT_MS=1200000
# How often the gateway re-reads only the local provider model lists (the
# bridge in front of Ollama/llama.cpp/LM Studio/vLLM). A model server that
# starts or stops later is reflected without a restart; cloud providers are
# never polled by this timer.
LOCAL_MODELS_REFRESH_MS=20000

# ─────────────── 8. Provider — custom_N (generic) ───────────────
# CUSTOM_PROVIDER_N_ENABLED=false removes the provider completely.
CUSTOM_PROVIDER_1_ENABLED=false
CUSTOM_PROVIDER_1_NAME=
CUSTOM_PROVIDER_1_URL=
CUSTOM_PROVIDER_1_KEY=
CUSTOM_PROVIDER_1_PRIORITY=
CUSTOM_PROVIDER_1_TYPE=openai
CUSTOM_PROVIDER_1_MODELS=
# Add more with the same block for N=2,3,... (Cloudflare providers are gone).

# llama.cpp has two adapters. Both share one base URL so a port change
# touches a single line.
LLAMA_CPP_BASE=http://127.0.0.1:9932
LLAMA_CPP_URL=${LLAMA_CPP_BASE}/v1
LLAMA_CPP_MODEL=

# custom_5: OpenAI-compatible /v1 adapter (streaming chat completions).
CUSTOM_PROVIDER_5_ENABLED=false
CUSTOM_PROVIDER_5_NAME=llama-cpu-openai
CUSTOM_PROVIDER_5_URL=${LLAMA_CPP_URL}
CUSTOM_PROVIDER_5_KEY=
CUSTOM_PROVIDER_5_PRIORITY=0
CUSTOM_PROVIDER_5_TYPE=openai
CUSTOM_PROVIDER_5_MODELS=
# Pair format: "name=>apiModel". A plain entry is a public name that equals
# the upstream model id, e.g. qwen3-1.7b-abliterated.
# Two providers may advertise the same apiModel; the lower priority number
# (0 is valid and strongest) decides which one serves the plain name. The
# masked name always resolves to the provider that defines it.
CUSTOM_PROVIDER_5_TIMEOUT_MS=300000
CUSTOM_PROVIDER_5_STREAM_TIMEOUT_MS=600000
# When set, the agent keeps its persona and drops bulk context so a slow CPU
# model can prefill and answer. 0 or unset means no cap.
CUSTOM_PROVIDER_5_MAX_PROMPT_CHARS=2500

# custom_6: native llama.cpp /completion adapter (no /v1 prefix).
CUSTOM_PROVIDER_6_ENABLED=false
CUSTOM_PROVIDER_6_NAME=llama-native
CUSTOM_PROVIDER_6_URL=${LLAMA_CPP_BASE}
CUSTOM_PROVIDER_6_KEY=
# Priority 1 keeps the plain apiModel on custom_5; the masked name
# "llama-native-qwen" still resolves here exactly.
CUSTOM_PROVIDER_6_PRIORITY=1
CUSTOM_PROVIDER_6_TYPE=llamacpp
CUSTOM_PROVIDER_6_MODELS=
# Pair format: "name=>apiModel", e.g. llama-native-qwen=>qwen3-1.7b-abliterated
CUSTOM_PROVIDER_6_TIMEOUT_MS=300000
CUSTOM_PROVIDER_6_STREAM_TIMEOUT_MS=600000
CUSTOM_PROVIDER_6_MAX_PROMPT_CHARS=2500

# ─────────────── 9. Linux - UDS ───────────────
# ONE inbound socket for every client. UDS_1..UDS_N are candidates: they are
# tried in numeric order, only the first usable path binds, the next one is
# the immediate fallback. Add UDS_4, UDS_5 ... without touching code.
# The same socket serves MCP newline JSON-RPC and OpenAI HTTP.
UDS_1=/tmp/zombiecoder/mcp.sock
UDS_2=/tmp/zombiecoder/mcp2.sock
UDS_3=/tmp/zombiecoder/mcp3.sock
# Set 0 to disable the OpenAI HTTP surface on the UDS (MCP stays available).
UDS_OPENAI=1
# Windows only: loopback TCP fallback because Windows has no UDS.
UDS_PORT=5150
GRPC_PORT=5052
# Optional in-process TLS listener: only starts when both files exist.
HTTPS_PORT=5444
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
LOCAL_UDS_TIMEOUT=10000
# Shell used by shell-exec (Linux and Windows)
EXEC_SHELL_LINUX=/bin/bash
EXEC_SHELL_WIN=powershell.exe

# ─────────────── 10. Local LLM bridge (local-llm-bridge.js) ───────────────
# CORS: empty = loopback origins only; "*" = any; or a comma-separated list
BRIDGE_ALLOWED_ORIGINS=
BRIDGE_PORT=11435
BRIDGE_INTERNAL_PORT=11437
# auto = discover any local OpenAI-compatible server; llama = also spawn a
# bundled llama-server when one is installed.
BRIDGE_BACKEND=auto
# Empty = use whichever model a live upstream reports. No invented model.
BRIDGE_MODEL=
BRIDGE_UPSTREAM_MODEL=
# Optional explicit upstreams: "name=url,name=url". Empty = probe the
# conventional local ports (Ollama 11434, llama.cpp 9932/8080, LM Studio 1234,
# vLLM 8000). A missing server is skipped, never fatal.
BRIDGE_UPSTREAMS=
BRIDGE_REFRESH_MS=15000
BRIDGE_PROBE_TIMEOUT_MS=1200
# 0 = probe only BRIDGE_UPSTREAMS, skip the conventional local ports.
BRIDGE_PROBE_DEFAULTS=1
BRIDGE_CTX=512
BRIDGE_THREADS=4
# Legacy single upstream; leave empty to rely on discovery.
BRIDGE_OLLAMA_URL=

# ─────────────── 11. MCP server ports (external mcp/) ───────────────
# Every local MCP port. The same values are used by Caddy and start-local-mcp.
OCR_MCP_PORT=3110
SCREEN_MCP_PORT=3111
TTS_MCP_PORT=3112
COMBINED_MCP_PORT=3123
PUBLIC_API_MCP_PORT=3122
FB_ADS_MCP_PORT=3121
ADAPTER_HTTP_PORT=5400
ADAPTER_HTTPS_PORT=5443
# Remote MCP servers (comma-separated "<name>:<url>")
EXTERNAL_MCP_URLS=
REMOTE_MCP_SERVERS=
MCP_CLIENTS_FILE=data/mcp-clients.json
MCP_READY_TIMEOUT_MS=30000

# ─────────────── 12. External integrations ───────────────
# Pusher (real-time dashboard)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Facebook Ads MCP
FB_ACCESS_TOKEN=
# PHP/Frontend (optional)
FRONTEND_PORT=8081
FRONTEND_URL=http://localhost:8081

# ─────────────── 13. Git content sync (optional) ───────────────
# persona/skill/instruction files pulled at startup (raw.githubusercontent URL)
GIT_PERSONAS_URL=
GIT_SKILLS_URL=
GIT_INSTRUCTIONS_URL=

# ─────────────── 14. Behaviour flags ───────────────
# Anti-Dote pipeline: validate → proof → contract → execute → verify
ANTIDOTE_ENABLED=true
# Boundary schema check: an invalid provider response is rejected, not forwarded
BOUNDARY_VALIDATE=true
# Dev-model template (HAS_DEV_MODELS=true shows temporary dev models)
HAS_DEV_MODELS=false
# r2t (response-to-tool) virtual model
R2T_ENABLED=false
# Heartbeat/watchdog interval (ms)
WATCHDOG_INTERVAL=60000
# Debate / back-end-for-end limit
MAX_DEBATE_ROUNDS=3
# Model alias — "alias:realModel", comma-separated
# `llama-local` is the stable agent-facing id; point it at the local model you
# actually run (install.sh fills the Ollama model when it is reachable).
MODEL_ALIASES=llama-local:llama3.2:latest
# Default model for every agent whose DB row and agent file name no model.
# Must be a model one configured provider serves (for example the public name
# from GEMINI_MODELS). Empty means chat requests fail with `Unknown model ""`
# instead of guessing a provider — set it.
AGENT_MODEL=
# Model for utility calls (intent extraction, alignment, proof checks). Empty
# means "first usable model in the live catalog", so no provider is required.
# Set it only when a specific cheap model should handle those calls.
UTILITY_MODEL=

# ─────────────── 15. Branding (API/display) ───────────────
BRANDING_ORGANIZATION=ZombieCoder
BRANDING_TAGLINE=Mission Barisal
BRANDING_WEBSITE=https://zombiecoder.my.id
BRANDING_EMAIL=infi@zombiecoder.my.id